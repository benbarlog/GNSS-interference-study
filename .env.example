# Copy to .env (gitignored) and fill in. Never commit .env.
# myACLED account: register with your UNIVERSITY email to get event-level ("Research") access;
# a gmail address only gets aggregated ("Open") data, which these scripts cannot use.
ACLED_EMAIL=
ACLED_PASSWORD=

# Optional: where the gnss-data folder is when it is not D:/gnss-data (e.g. the USB drive on the laptop).
# If unset, the analysis scans drive letters for a gnss-data folder automatically.
GNSS_DATA_ROOT=
